#!/usr/bin/env python3
"""
curie – CLI entry point for Curie AI.

Run `curie --help` for usage information.
"""

import os
import sys

# Prefer the project-local environment created by the installer. Re-exec once
# so GPU-enabled native libraries and all Python dependencies are consistent.
_repo_root = os.path.dirname(os.path.abspath(__file__))
_venv_python = os.path.join(_repo_root, ".venv", "bin", "python")
_venv_root = os.path.join(_repo_root, ".venv")
# Do not compare executable realpaths: a virtualenv's ``bin/python`` normally
# symlinks to the system binary, making an inactive system interpreter look
# identical. ``sys.prefix`` reliably identifies the active environment.
if os.path.isfile(_venv_python) and os.path.abspath(sys.prefix) != os.path.abspath(
    _venv_root
):
    os.execv(_venv_python, [_venv_python, os.path.abspath(__file__), *sys.argv[1:]])

# Ensure the repo root is on sys.path so `cli` and other packages can be found
if _repo_root not in sys.path:
    sys.path.insert(0, _repo_root)

from cli.main import main

if __name__ == "__main__":
    sys.exit(main())
