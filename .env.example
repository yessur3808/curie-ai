TELEGRAM_BOT_TOKEN=your_telegram_bot_token
DISCORD_BOT_TOKEN=your_discord_bot_token
WHATSAPP_SESSION_PATH=./whatsapp_session

LLM_MODELS=Qwen3.5-9B-Q4_K_M.gguf,gpt-oss-20b-MXFP4.gguf,Mistral-Small-3.2-24B-Instruct-2506-Q4_K_M.gguf,Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf,Qwen3-4B-Q4_K_M.gguf
LLM_GENERAL_MODEL=Qwen3.5-9B-Q4_K_M.gguf
LLM_FAST_MODEL=Qwen3-4B-Q4_K_M.gguf
LLM_REASONING_MODEL=gpt-oss-20b-MXFP4.gguf
LLM_AGENT_MODEL=gpt-oss-20b-MXFP4.gguf
LLM_CRITIC_MODEL=Mistral-Small-3.2-24B-Instruct-2506-Q4_K_M.gguf
LLM_CODING_MODEL=Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf
CODING_MODEL_NAME=Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf
LLM_MAX_LOADED_MODELS=2
LLM_PARALLEL_WORKERS=2
LLM_ENSEMBLE_ENABLED=true  # Explicit "use multiple agents" requests only
LLM_ENSEMBLE_AUTO_COMPLEX=true  # Multi-model review for bounded high-value tasks
LLM_ENSEMBLE_EVAL_GAIN=0       # Set from evaluation results; auto ensemble needs >= 0.03
LLM_ENSEMBLE_MIN_GAIN=0.03
INFERENCE_QUEUE_SIZE=16         # Process-wide bounded inference backlog
INFERENCE_WORKERS=1             # One owner for local large-model execution
LLM_ENSEMBLE_CRITIC_BACKEND=critic  # Use LLM_CRITIC_MODEL for independent review

# LLM Provider Priority (comma-separated, tried in order)
# Options: anthropic, openai, gemini, llama.cpp
# Default: llama.cpp (local only). Add cloud providers to use them.
# Example: LLM_PROVIDER_PRIORITY=anthropic,openai,gemini,llama.cpp
LLM_PROVIDER_PRIORITY=llama.cpp

# Cloud LLM API Keys (optional — leave blank to use only local models)
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-terra

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google Gemini
# GOOGLE_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# Route simple/short queries to local model even when cloud providers are available
# Set to true to always use cloud for everything (more costs, higher quality)
LLM_CLOUD_SIMPLE_TASKS=true

# LLM Context Window Configuration
# ──────────────────────────────────────────────────────────────────────────────
# LLM_CONTEXT_SIZE controls how many tokens the local llama.cpp model can hold
# at one time (prompt + response combined).  The default is 2048 which is safe
# for all GGUF models, but most modern models (Llama 3.1+, Mistral, etc.) support
# at least 4096 — set it higher if your hardware allows, especially for trip
# planning and long conversations.
#
#   2048 — safe fallback for any model
#   4096 — recommended for planning / long-form skills (Llama 3.1 8B and newer)
#   8192 — best quality; requires at least 8 GB VRAM / RAM
#
LLM_CONTEXT_SIZE=16384
LLM_DISABLE_THINKING=true  # Qwen: return final answers without private <think> output
LLM_USE_CHAT_TEMPLATE=true  # Use the GGUF model's native instruction template
# LLM_CONTEXT_BUFFER=16   # Buffer reserved for system tokens (default: 16)
# LLM_MIN_TOKENS=64       # Minimum tokens required for a response (default: 64)
# LLM_FALLBACK_MAX_TOKENS=512  # Fallback max_tokens if tokenization fails (default: 512)
# LLM_DEFAULT_MAX_TOKENS=256   # Default max_tokens when not explicitly specified (default: 256)
# LLM_THREADS=8           # CPU threads for inference (default: all logical cores)
# Automatic hardware selection (CPU fallback is always available)
# LLM_ACCELERATOR_MODE=auto  # auto, cpu, gpu, or npu
# LLM_GPU_LAYERS=auto        # auto, 0=CPU-only, -1=full GPU offload, N=partial hybrid
# LLM_NPU_ROUTING=simple     # simple, all, or off
# LLM_NPU_BINARY=/path/to/flm
# LLM_NPU_MODEL=qwen3-it:4b
# LLM_NPU_PORT=13306

# Long-conversation summarisation
# HISTORY_SUMMARISE_THRESHOLD=20  # Summarise history when it exceeds this many turns (default: 20)
# CURIE_CONTEXT_TOKEN_BUDGET=7600 # Dynamic prompt-context ceiling; current requests and atomic consequential receipts are never silently truncated
# CURIE_MAX_MESSAGE_CHARS=32000
# CURIE_MAX_MESSAGE_BYTES=131072
# CURIE_MAX_ATTACHMENTS=12
# CURIE_MAX_ATTACHMENT_BYTES=26214400
# CURIE_MAX_TOTAL_ATTACHMENT_BYTES=52428800
# HISTORY_KEEP_RECENT=6           # Recent turns to keep verbatim after summarisation (default: 6)
CHAT_MAX_HISTORY=25               # Conversation pairs loaded for smooth long-form chat

# Typed turn pipeline rollout. Phase 11 defaults to the new pipeline while the
# temporary legacy path remains available as an immediate circuit-breaker.
CURIE_TURN_PIPELINE_STAGE=default_active
CURIE_TURN_PIPELINE_MODE=active
# CURIE_TURN_PIPELINE_ACTIVE_OWNERS=owner-id
# CURIE_TURN_PIPELINE_DEVICE_CANARY=Floor Lamp
# CURIE_TURN_PIPELINE_ACTIVE_CONNECTORS=telegram
# CURIE_PIPELINE_ROLLOUT_STATE=~/.curie/pipeline-rollout.json
CURIE_LEGACY_PIPELINE_OWNER=curie-maintainers
CURIE_LEGACY_PIPELINE_DEADLINE=2026-10-22

# Info Search Task Configuration
# INFO_SEARCH_TEMPERATURE=0.2  # Temperature for info search LLM calls (default: 0.2, lower for more deterministic results)
# INFO_SEARCH_MAX_TOKENS=512  # Max tokens for info search responses (default: 512, must leave room for prompt in 2048 context)
# INFO_SEARCH_MAX_SOURCES=3  # Maximum number of sources to process (default: 3, prevents context overflow)
# INFO_SEARCH_MAX_SNIPPET_CHARS=400  # Maximum characters per snippet (default: 400, ~100 tokens)

# Voice/Audio Configuration
# WHISPER_MODEL=base  # Whisper model: tiny, base, small, medium, large (default: base)

MASTER_USER_ID=123456789  # <--- Replace with your own user ID
NOTIFY_MASTER_ON_STARTUP=true

# Default timezone and location for the assistant.
# Used when a user has not yet set their own preferences through conversation.
# The assistant will use these to give accurate date/time/location context.
# timezone must be a valid tz database name: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DEFAULT_TIMEZONE=UTC
DEFAULT_LOCATION=

# Internet Time Verification
# The assistant reads the current date & time from the system clock.
# When ENABLE_TIME_VERIFICATION=true (default), it also fires a background
# request to a public NTP-backed REST API to detect if the system clock has
# drifted and logs a warning if so.  The check is cached for TIME_CACHE_TTL
# seconds so it never runs on every message.  Set to false for air-gapped setups.
# ENABLE_TIME_VERIFICATION=true
# TIME_API_URL=https://worldtimeapi.org/api/timezone/UTC
# TIME_API_TIMEOUT=3.0      # HTTP connect+read timeout in seconds (default: 3.0)
# TIME_DRIFT_WARN_SECONDS=5.0  # Log a warning if clock drift exceeds this (default: 5.0)
# TIME_CACHE_TTL=300        # Re-check internet time every N seconds (default: 300)

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assistant_db
POSTGRES_USER=your_pg_user
POSTGRES_PASSWORD=your_pg_password

MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=assistant_db

# Session Management Configuration
# SESSION_SCOPE=per_channel_user  # Options: single, per_user, per_channel_user (default: per_channel_user)
# SESSION_MAX_HISTORY=50          # Max messages to retain per session (default: 50)
# SESSION_COLLECTION=sessions     # MongoDB collection name for sessions (default: sessions)

# GitHub Integration (for code operations and PR management)
GITHUB_TOKEN=ghp_*********************************
MAIN_REPO=https://github.com/johndoe/abc_project
MAIN_REVIEWER=MainCoder_or_yourself
TARGET_BRANCH=main

# GitLab Integration (optional - for GitLab code operations)
# GITLAB_TOKEN=glpat-****************************
# GITLAB_URL=https://gitlab.com  # Or your self-hosted GitLab instance

# Bitbucket Integration (optional - for Bitbucket code operations)
# BITBUCKET_USERNAME=your_username
# BITBUCKET_APP_PASSWORD=your_app_password

# Self-Update Configuration (optional)
# SYSTEMD_SERVICE_NAME=curie-ai  # Systemd service name for automated restarts
# SERVICE_RESTART_TIMEOUT=30  # Timeout in seconds for service restart (default: 30)

# Code Review Configuration (optional)
# CODE_REVIEW_MAX_CHARS=4000  # Maximum characters to read from a file for review (default: 4000)

# Connector Flags - Set which connectors to run
RUN_TELEGRAM=true
RUN_DISCORD=false
RUN_WHATSAPP=false
RUN_API=true
CURIE_API_HOST=127.0.0.1
CURIE_API_PORT=8000
RUN_CODER=false
RUN_CODING_SERVICE=false  # Run standalone coding service in parallel
RUN_SLACK=false           # Slack connector (requires SLACK_BOT_TOKEN + SLACK_APP_TOKEN)
RUN_SIGNAL=false          # Signal connector (requires SIGNAL_CLI_API_URL + SIGNAL_PHONE_NUMBER)

# Slack Connector (optional — requires slack-bolt: pip install slack-bolt)
# SLACK_BOT_TOKEN=xoxb-...          # Bot OAuth token from api.slack.com/apps
# SLACK_APP_TOKEN=xapp-...          # App-level token (Socket Mode)

# Signal Connector (optional — requires a running signal-cli REST API server)
# See: https://github.com/bbernhard/signal-cli-rest-api
# SIGNAL_CLI_API_URL=http://localhost:8080   # Base URL of the signal-cli REST API
# SIGNAL_PHONE_NUMBER=+1234567890            # Registered Signal phone number for the bot
# SIGNAL_POLL_INTERVAL=2                     # Seconds between polls (default: 2)

# Microsoft Teams Connector (webhook — no extra package needed)
# Register a bot at https://dev.botframework.com/ and set the messaging endpoint to:
#   https://<your-host>/teams/messages
# TEAMS_APP_ID=<azure-app-id>
# TEAMS_APP_PASSWORD=<azure-app-password>

# LINE Messaging API Connector (webhook — no extra package needed)
# Create a LINE Official Account at https://developers.line.biz/console/
# Set the webhook URL to:  https://<your-host>/line/webhook
# LINE_CHANNEL_ACCESS_TOKEN=<channel-access-token>
# LINE_CHANNEL_SECRET=<channel-secret>

# KakaoTalk i Open Builder Connector (webhook — no extra package needed)
# Create a chatbot at https://i.kakao.com/ and set the skill server URL to:
#   https://<your-host>/kakao/webhook
# KAKAO_VERIFY_TOKEN=<optional-verification-token>

# Proactive Messaging Configuration
ENABLE_PROACTIVE_MESSAGING=true  # Enable/disable proactive messaging feature (default: true)
PROACTIVE_CHECK_INTERVAL=900  # Check eligibility every 15 minutes
PROACTIVE_STARTUP_DELAY=10  # Let outbound connectors become ready first
PROACTIVE_MESSAGE_PROBABILITY=1.0  # Send whenever eligible; cadence and daily caps still apply
PROACTIVE_PREDICTIONS_ENABLED=true
PROACTIVE_PREDICTION_MIN_CONFIDENCE=0.82

# Typed intent routing. Explicit actions remain deterministic. The model is
# consulted only for ambiguous action-like language and cannot authorize writes.
INTENT_LLM_ENABLED=true

# Bound outbound connector work so temporary transport failures cannot create
# unbounded in-memory backlogs.
CONNECTOR_OUTBOUND_QUEUE_SIZE=64
CONNECTOR_READY_TIMEOUT=15
INFERENCE_QUEUE_SIZE=8
INFERENCE_WORKERS=1
TELEGRAM_MAX_ATTACHMENT_BYTES=20971520
ATTACHMENT_MAX_EXTRACTED_CHARS=50000
# Attachment security. Set scanner requirement to true on deployments that
# accept media from anyone besides the owner; missing ClamAV then fails closed.
CURIE_REQUIRE_MALWARE_SCANNER=false
CURIE_ARCHIVE_MAX_MEMBERS=2000
CURIE_ARCHIVE_MAX_EXPANDED_BYTES=104857600
MEDIA_CONCURRENCY_LIMIT=1
CURIE_MIN_FREE_DISK_BYTES=2147483648

# Visible retention limits in days. Zero means delete during the next cleanup.
CURIE_RETENTION_MESSAGES_DAYS=30
CURIE_RETENTION_TRANSCRIPTS_DAYS=7
CURIE_RETENTION_GENERATED_SPEECH_DAYS=0
CURIE_RETENTION_TEMPORARY_MEDIA_DAYS=0
CURIE_AUDIT_RETENTION_DAYS=90
CURIE_RETENTION_COMPLETED_TASKS_DAYS=90
CURIE_RETENTION_OPERATIONAL_EVENTS_DAYS=30
VISION_MODEL_PATH=
VISION_MMPROJ_PATH=
VISION_CONTEXT_SIZE=4096
# Keep vision on CPU by default. Loading a second model onto an integrated GPU
# can exhaust shared VRAM and terminate the entire daemon at the native-driver
# level before Curie has a chance to fall back gracefully.
VISION_N_GPU_LAYERS=0

# Curie's provisioned trained voice is the authoritative outbound voice on all
# connectors and APIs. If it is unavailable, keep the reply text-only instead
# of silently changing Curie's identity. Set this false only for an intentional
# emergency rollback to the legacy Piper/eSpeak/XTTS engines below.
CURIE_TRAINED_VOICE_REQUIRED=true
CURIE_TRAINED_VOICE_TIMEOUT_SECONDS=115
CURIE_TRAINED_VOICE_QUEUE_SECONDS=3
# CURIE_TRAINED_VOICE_LOCK_PATH=/absolute/private/path/runtime.lock

# Legacy rollback voice configuration. These engines are not used while
# CURIE_TRAINED_VOICE_REQUIRED=true.
PIPER_BINARY=piper
PIPER_MODEL_PATH=
PIPER_ENGLISH_MODEL_PATH=
PIPER_FRENCH_MODEL_PATH=
# Keep this false for production-quality voice. When false, a missing neural
# voice falls back to text instead of sending a robotic eSpeak recording.
LOCAL_TTS_ALLOW_ESPEAK=false
LOCAL_TTS_ESPEAK_VOICE=en+f4
LOCAL_TTS_SPEED=155
LOCAL_TTS_PITCH=58
# Optional consent-gated legacy custom voice, available only during explicit
# trained-voice rollback. Provision all files locally and enroll a consenting
# voice; Curie never downloads this model during chat.
XTTS_MODEL_PATH=
XTTS_CONFIG_PATH=
SLACK_MAX_ATTACHMENT_BYTES=20971520

# Chat Behavior Configuration
MINIMAL_SANITIZATION=true  # Use minimal sanitization for natural chat (default: true). Set to false for aggressive sanitization that removes all code.

# Persona/Assistant Configuration
ASSISTANT_NAME=Curie  # Display name of your AI assistant
# Available persona files in assets/personality:
#   personality.json (default polished assistant)
#   jarvis.json (formal, tactical, high-precision)
#   friday.json (friendly, adaptive, proactive)
#   gideon.json (analytical, strategic, context-heavy)
#   bagley.json (witty, efficient, slightly sarcastic)
#   curie.json (warm, scientific, French-accented companion)
PERSONA_FILE=curie.json  # Persona config filename (or "all" for multi-persona mode)

# Proactive Learning (auto-extract user preferences from conversations)
# ENABLE_LEARNING=true       # Enable/disable proactive learning (default: true)
# LEARNING_MAX_FACTS=50      # Max facts to store per user (default: 50)
# ADAPTIVE_MEMORY_MIN_CONFIDENCE=0.80
# ADAPTIVE_INFERRED_TTL_DAYS=45
# LEARNING_SESSION_TTL_MINUTES=180       # Level 0 session-only adaptation expiry
# LEARNING_LEVEL2_MIN_EVIDENCE=3         # Independent signals before a candidate exists
# LEARNING_SHADOW_MIN_OBSERVATIONS=20    # Reviewed shadow traces before promotion
# LEARNING_CANARY_MIN_OBSERVATIONS=20    # Canary outcomes before Level 3 promotion
# auto uses the Rust ABI3 kernel when installed and the audited Python rollback
# otherwise. Set rust in production after `make memory-kernel` to fail closed.
CURIE_MEMORY_KERNEL=auto
# Native bounded attachment/audio inspection, WAV transport, and worker supervision.
# Set rust after `make media-transport` to require the native transport.
CURIE_MEDIA_TRANSPORT=rust
# CURIE_MEDIA_MAX_OUTPUT_BYTES=268435456
# MEMORY_RELEVANCE_MIN_SCORE=0.28  # Hard recall threshold; higher is stricter
# MEMORY_CONTEXT_CHAR_BUDGET=1600 # Max long-term memory text injected per request
# MEMORY_MAX_CANDIDATES=500        # Max owner-filtered records ranked per recall
# MEMORY_RERANK_CANDIDATES=96      # Plausible candidates receiving vector reranking
# MEMORY_RETRIEVAL_CACHE_SIZE=4096 # In-process LRU of compiled semantic features
# MEMORY_EPISODE_TTL_DAYS=180     # Retention for salient decisions/goals/milestones
# CURIE_LOCAL_MEMORY_DB=.curie_memory.sqlite3  # Used when Mongo/Postgres are unset
# CURIE_WORKSPACE_ROOT=.                       # Master user's allowed workspace
# CURIE_PROJECTS_ROOT=./projects               # Per-user project sandboxes


PROJECTS_ROOT=/var/projects
CURIE_AUDIT_RETENTION_DAYS=90
# Optional private rotating application log (stdout remains enabled).
CURIE_LOG_FILE=
CURIE_LOG_MAX_BYTES=5000000
CURIE_LOG_BACKUP_COUNT=5
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=
X_OAUTH_DM_SCOPES_ENABLED=false
# Generate these independently; never reuse an account password.
CURIE_CREDENTIAL_KEY=
CURIE_SETUP_TOKEN=
CURIE_CREDENTIAL_STORE=.curie_credentials.enc
CURIE_BROWSER_STATE_ROOT=.curie-browser

# Smart-home integrations. Keep credentials in the private .env or Curie's
# encrypted credential vault; never paste real tokens into chat or source code.
SMARTTHINGS_TOKEN=
GOVEE_API_KEY=
LG_THINQ_PAT=
LG_THINQ_COUNTRY=US
# A stable UUID generated once for this Curie installation.
LG_THINQ_CLIENT_ID=
TAPO_USERNAME=
TAPO_PASSWORD=
# JSON arrays must stay on one line in .env. Local adapters accept only private
# LAN addresses, single-label hostnames, or .local hostnames.
TAPO_DEVICES_JSON=[]
NANOLEAF_DEVICES_JSON=[]
MI_HOME_DEVICES_JSON=[]
# Petlibro has no supported public consumer API. Curie uses the Petlibro
# integration in a local Home Assistant instance as a stable control bridge.
PETLIBRO_HA_URL=
PETLIBRO_HA_TOKEN=
PETLIBRO_ENTITIES_JSON=[]
# Phase 3: schema-constrained intent classification and calibrated abstention.
INTENT_CLASSIFIER_MODEL=fast
INTENT_CLASSIFIER_ABSTAIN_THRESHOLD=0.78

# Phase 4: bounded canonical inventory and conservative entity matching.
HOME_INVENTORY_REFRESH_SECONDS=30
HOME_INVENTORY_STALE_SECONDS=300
HOME_INVENTORY_WARM_ON_STARTUP=true
HOME_INVENTORY_STARTUP_OWNER_TIMEOUT_SECONDS=15
DEVICE_FUZZY_MUTATION_THRESHOLD=0.90
DEVICE_FUZZY_READ_THRESHOLD=0.82
DEVICE_FUZZY_AMBIGUITY_GAP=0.10

# Phase 5: exact plan-bound approval lifetime.
CURIE_APPROVAL_TTL_MINUTES=30
